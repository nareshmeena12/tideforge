#!/bin/bash
# GENERATED by tideforge/slurm.py: edit the generator, not this file.
#SBATCH -A m4392_g
#SBATCH -C gpu
#SBATCH -q regular
#SBATCH -N 1
#SBATCH --gpus=4
#SBATCH -c 128
#SBATCH -t 02:00:00
#SBATCH -J t3_e07
#SBATCH -o %x-%j.out
#SBATCH --signal=B:USR1@120
#SBATCH --requeue
#SBATCH --open-mode=append
# E0.7 (5M B0, seeds 0-2) and E0.8 (white-noise control, seed 0): one run per GPU, then finish each
set -u
source "$SCRATCH/tideforge/repo/scripts/perlmutter/env.sh" || exit 2
echo "$(date) job $SLURM_JOB_ID on $(hostname), restart count ${SLURM_RESTART_COUNT:-0}"
# two minutes before the time limit: SIGUSR1 is forwarded to the trainers (save + exit 3), then requeue
mkdir -p "$TF_ROOT/runs" "$TF_ROOT/logs"
git -C "$TF_REPO" log --oneline -1
PIDS=()
forward() {
    echo "$(date) SIGUSR1: asking the trainers to save and stop"
    for p in "${PIDS[@]}"; do kill -USR1 "$p" 2>/dev/null; done
    wait
    scontrol requeue "$SLURM_JOB_ID"; exit 0
}
trap forward USR1
CUDA_VISIBLE_DEVICES=0 python -m tideforge.train.trainer --exp E0.7 --seed 0 --out "$TF_ROOT/runs" > "$TF_ROOT/logs/t3_e07_E0.7_s0.log" 2>&1 &
PIDS+=($!)
CUDA_VISIBLE_DEVICES=1 python -m tideforge.train.trainer --exp E0.7 --seed 1 --out "$TF_ROOT/runs" > "$TF_ROOT/logs/t3_e07_E0.7_s1.log" 2>&1 &
PIDS+=($!)
CUDA_VISIBLE_DEVICES=2 python -m tideforge.train.trainer --exp E0.7 --seed 2 --out "$TF_ROOT/runs" > "$TF_ROOT/logs/t3_e07_E0.7_s2.log" 2>&1 &
PIDS+=($!)
CUDA_VISIBLE_DEVICES=3 python -m tideforge.train.trainer --exp E0.8 --seed 0 --out "$TF_ROOT/runs" > "$TF_ROOT/logs/t3_e07_E0.8_s0.log" 2>&1 &
PIDS+=($!)
RC=0
for p in "${PIDS[@]}"; do wait "$p"; c=$?; [ "$c" -eq 0 ] || RC=$c; done
if [ "$RC" -eq 3 ]; then echo "$(date) a trainer stopped to be requeued"; scontrol requeue "$SLURM_JOB_ID"; exit 0; fi
[ "$RC" -eq 0 ] || { echo "$(date) a run FAILED (exit $RC): see $TF_ROOT/logs/t3_e07_*.log"; exit 1; }
echo "$(date) t3_e07 JOB DONE"
